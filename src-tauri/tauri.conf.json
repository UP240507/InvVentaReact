{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InvVenta",
  "version": "0.2.6",
  "identifier": "app.invventa.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InvVenta — Sistema Operativo Gastronómico",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "maximized": true,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "width": 420,
        "height": 340,
        "decorations": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "../dist"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/UP240507/InvVentaReact/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2RTQyRkRENzJCNjg5MUUKUldRZWliWnkzUy9reGhQeTMwWHJkam9XSUc2UVNwMTlqY3BkaE9RRjY4MFhqeGxKcHRtdXJqNU0K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
