    "contraste": "node scripts/verificar-contraste.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"scripts/**/*.mjs\"",
    "tauri": "tauri",
    "version": "node scripts/version.mjs",
    "release": "node scripts/latest-json.mjs",
    "publicar": "node scripts/publicar.mjs"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.1.0",
